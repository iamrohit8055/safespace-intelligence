# SafeSpace Intelligence Frontend Configuration

# Base URL for API requests (when proxied via Vite dev server, /api/v1 routes to localhost:8000/api/v1)
VITE_API_BASE_URL=/api/v1

# Optional Vector map style URL for MapLibre GL JS (Default to built-in high-resolution CARTO Voyager / OSM raster tiles)
# VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json
