# ==============================================================================
# SafeSpace Intelligence — Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env` in the project root:
#      cp .env.example .env
# 2. Update all placeholders with your local development or production values.
# 3. NEVER commit the actual `.env` file to version control.
# ==============================================================================

# Application Settings
APP_NAME="SafeSpace Intelligence"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Security & Authentication
# WARNING: The secret key below is a development placeholder.
# In production, generate a secure 64-character random key using:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="development_secret_key_change_in_production_min_32_chars"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL 17 + PostGIS)
POSTGRES_USER="safespace_user"
POSTGRES_PASSWORD="safespace_password"
POSTGRES_DB="safespace_db"
POSTGRES_PORT=5433
POSTGRES_HOST="127.0.0.1"

# Database Connection URL (Synchronous SQLAlchemy with psycopg 3 driver)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+psycopg://safespace_user:safespace_password@127.0.0.1:5433/safespace_db"

# Cross-Origin Resource Sharing (CORS)
# JSON-encoded array or comma-separated list of allowed origin URLs
CORS_ORIGINS='["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]'
